                                <script>(function () {
  'use strict';

  /* === CSS ASLI (tetap) === */
  const style = document.createElement('style');
  style.innerHTML = `
    .jet-form-builder-file-upload__content {
      border: 2px dashed #ddd !important;
      border-radius: 8px;
      background-color: #fafafa !important;
      position: relative;
    }
    .jet-form-builder-file-upload__content.has-file {
      border: none !important;
      background-color: transparent !important;
    }
    .jet-photo-placeholder-icon {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: .5;
      cursor: pointer;
      z-index: 10;
    }
  `;
  document.head.appendChild(style);

  function createIcon() {
    const icon = document.createElement('div');
    icon.className = 'jet-photo-placeholder-icon';
    icon.innerHTML = `
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.5">
        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8
                 a2 2 0 0 1 2-2h4l2-3h6l2 3h4
                 a2 2 0 0 1 2 2z"/>
        <circle cx="12" cy="13" r="4"/>
      </svg>
    `;
    return icon;
  }

  function init(container) {
    if (container.dataset.ready) return;
    container.dataset.ready = '1';

    const icon = createIcon();
    container.appendChild(icon);

    icon.addEventListener('click', e => {
      e.preventDefault();
      e.stopPropagation();
      const input =
        container.querySelector('input[type="file"]') ||
        container.closest('.jet-form-builder-file-upload')?.querySelector('input[type="file"]');
      input && input.click();
    });

    const filesBox = container.querySelector('.jet-form-builder-file-upload__files');
    if (!filesBox) return;

    const toggle = () => {
      const hasFile = filesBox.children.length > 0;
      container.classList.toggle('has-file', hasFile);
      icon.style.display = hasFile ? 'none' : 'block';
    };

    toggle();
    new MutationObserver(toggle).observe(filesBox, {
      childList: true,
      subtree: true
    });
  }

  function scan() {
    document
      .querySelectorAll('.jet-form-builder-file-upload__content')
      .forEach(init);
  }

  // init awal
  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', scan)
    : scan();

  // 🔥 OBSERVER KHUSUS UNTUK REPEATER
  new MutationObserver(mutations => {
    mutations.forEach(m => {
      m.addedNodes.forEach(node => {
        if (node.nodeType !== 1) return;

        if (node.matches?.('.jet-form-builder-file-upload__content')) {
          init(node);
        }

        node
          .querySelectorAll?.('.jet-form-builder-file-upload__content')
          .forEach(init);
      });
    });
  }).observe(document.body, {
    childList: true,
    subtree: true
  });

})();
</script>
                                 
